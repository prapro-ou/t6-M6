  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=120%><color=#8B0000>\u3010\u30E2\u30EB\u30C3\u30AF\u3068\u306F\uFF1F\u3011</color></size></b>\r\n\u30D5\u30A3\u30F3\u30E9\u30F3\u30C9\u3067\u884C\u308F\u308C\u3066\u304D\u305F\u30B2\u30FC\u30E0\u300C\u30AD\u30A4\u30C3\u30AB\u300D\u3092\u5143\u306B\u958B\u767A\u3055\u308C\u305F\u30B9\u30DD\u30FC\u30C4\u3067\u3059\u3002\r\n\r\n<b><size=120%><color=#8B0000>\u3010\u9053\u5177\u3011</color></size></b>\r\n\u30FB<b>\u30E2\u30EB\u30C3\u30AF</b>\uFF1A\u6295\u3052\u308B\u68D2\u306E\u3053\u3068\u3002\r\n\u30FB<b>\u30B9\u30AD\u30C3\u30C8\u30EB</b>\uFF1A\u6A19\u7684\u3068\u306A\u308B\u30D4\u30F3\u306E\u3053\u3068\u3002\r\n\r\n<b><size=120%><color=#8B0000>\u3010\u57FA\u672C\u30EB\u30FC\u30EB\u3011</color></size></b>\r\n\u30FB<b>1\u672C\u3060\u3051\u5012\u3057\u305F\u5834\u5408</b>\uFF1A\u30B9\u30AD\u30C3\u30C8\u30EB\u306B\u66F8\u304B\u308C\u305F\u6570\u5B57\u304C\u305D\u306E\u307E\u307E\u5F97\u70B9\u306B\u306A\u308A\u307E\u3059\u3002\r\n\u30FB<b>\u8907\u6570\u5012\u3057\u305F\u5834\u5408</b>\uFF1A\u5012\u3057\u305F\u300C\u672C\u6570\u300D\u304C\u5F97\u70B9\u306B\u306A\u308A\u307E\u3059\u3002\r\n\u30FB<b>\u3074\u3063\u305F\u308A50\u70B9\u5230\u9054\u3067\u52DD\u5229\uFF01</b>
    50\u70B9\u3092\u8D85\u3048\u3066\u3057\u307E\u3046\u3068<b>25\u70B9</b>\u306B\u6E1B\u70B9\u3055\u308C\u3066\u623B\u308A\u307E\u3059\u3002\r\n\u30FB<b>3\u56DE\u9023\u7D9A\u3067\u30DF\u30B9</b>\uFF081\u672C\u3082\u5012\u305B\u306A\u3044\uFF09\u3059\u308B\u3068\u305D\u306E\u5834\u3067\u6557\u5317\u3068\u306A\u308A\u307E\u3059\u3002\r\n\r\n<b><size=120%><color=#8B0000>\u3010\u30A2\u30A4\u30C6\u30E0\u306B\u3064\u3044\u3066\u3011</color></size></b>\r\n\u30B9\u30AD\u30C3\u30C8\u30EB\u624B\u524D\u306B\u6D6E\u304B\u3076\u30A2\u30A4\u30C6\u30E0\u30DC\u30C3\u30AF\u30B9\u306B\u30E2\u30EB\u30C3\u30AF\u3092\u5F53\u3066\u308B\u3068\u3001\u6B21\u30BF\u30FC\u30F3\u3067\u5F37\u5236\u767A\u52D5\u3057\u307E\u3059\u3002\r\n\u30FB<b>\u30DC\u30E0</b>\uFF1A\uFF08\u52B9\u679C\u306E\u8AAC\u660E\uFF09\r\n\u30FB<b>\u30ED\u30B1\u30C3\u30C8</b>\uFF1A\uFF08\u52B9\u679C\u306E\u8AAC\u660E\uFF09\r\n\u30FB<b>\u6697\u95C7</b>\uFF1A\uFF08\u52B9\u679C\u306E\u8AAC\u660E\uFF09\r\n\u30FB<b>\u98A8</b>\uFF1A\uFF08\u52B9\u679C\u306E\u8AAC\u660E\uFF09\r\n\r\n<b><size=120%><color=#8B0000>\u3010\u64CD\u4F5C\u65B9\u6CD5\u3011</color></size></b>\r\n\u30FB<b>[WASD]
    / [\u77E2\u5370\u30AD\u30FC]</b>\uFF1A\u72D9\u3044\uFF08\u30A8\u30A4\u30E0\uFF09\u3092\u52D5\u304B\u3059\r\n\u30FB<b>[Space]</b>\uFF1A1\u56DE\u76EE\u3067\u30D1\u30EF\u30FC\u30B2\u30FC\u30B8\u958B\u59CB\u3001\u30BF\u30A4\u30DF\u30F3\u30B0\u3088\u304F\u3082\u30461\u56DE\u62BC\u3057\u3066\u30E2\u30EB\u30C3\u30AF\u3092\u6295\u3052\u308B\r\n\u30FB\u6295\u64F2\u5F8C\u3001<b>\u300C\u6B21\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u300D</b>\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u30BF\u30FC\u30F3\u3092\u4EA4\u4EE3\u3057\u307E\u3059\u3002"
